    "text": "<e type=\"text_bold\" title=\"%E5%A4%A7%E5%BF%AB%E4%BA%BA%E5%BF%83%EF%BC%9A%E6%81%92%E5%A4%A7%E8%AE%B8%E5%AE%B6%E5%8D%B0%E6%A1%88%E4%B8%80%E5%AE%A1%E8%90%BD%E5%9C%B0%EF%BC%8C%E8%AE%B8%E5%AE%B6%E5%8D%B0%E5%BD%93%E5%BA%AD%E8%AE%A4%E7%BD%AA%EF%BC%81\" />\n\n古往今来、海内外案例，尤其是美国掀起的几次全球性金融危机告诉我们，如果任由金融系统性自由化，国家前途危矣。\n\n资本家可以通过金融危机获利，但是，最广大的普罗大众就惨了，轻则生活水平降级，重则地区动乱、生命也朝不保夕。\n\n打击犯罪，尤其是巨额财经犯罪，最重要就是断其整个家族后路，让犯罪者在地球无容身之处，也不能让他们的家族成员有花钱享受的地方<e type=\"hashtag\" hid=\"48851542415588\" title=\"%23pure%E6%97%A5%E6%9C%88%E5%8E%86%E5%8F%B2%E9%A2%84%E6%B5%8B%E8%8D%9F%E8%90%83%23\" /><e type=\"hashtag\" hid=\"51158524285514\" title=\"%23pure%E6%97%A5%E6%9C%88%E8%B4%A2%E7%BB%8F%E7%BA%B5%E6%A8%AA%23\" /><e type=\"hashtag\" hid=\"15548421284452\" title=\"%23pure%E6%97%A5%E6%9C%88%E5%85%B1%E5%90%8C%E5%AF%8C%E8%A3%95%23\" /><e type=\"hashtag\" hid=\"28821254512241\" title=\"%23pure%E6%97%A5%E6%9C%88%E6%88%BF%E5%9C%B0%E4%BA%A7%E7%A0%94%E7%A9%B6%23\" /><e type=\"hashtag\" hid=\"48851525482528\" title=\"%23pure%E6%97%A5%E6%9C%88%E8%BE%A9%E8%AF%81%E6%80%9D%E7%BB%B4%23\" /><e type=\"hashtag\" hid=\"15514441518222\" title=\"%23pure%E6%97%A5%E6%9C%88%E6%96%A9%E5%A6%96%E9%99%A4%E9%AD%94%23\" /> ...",
