    "questionee": {
      "user_id": 182558825454882,
      "name": "躬行客",
      "alias": "躬行客（可提问）",
      "avatar_url": "https://images.zsxq.com/Fkhp0MUKTAamKQ7tZoW-Q-SmYAwu?imageMogr2/auto-orient/thumbnail/150x/format/jpg/blur/1x0/quality/75/ignore-error/1&e=1780243199&token=q6iZ0sQtf9U7s1qz0r4yMawNq3-u2w6lbnai6y2J:6J1k-HcCufN2k9XE6MKlpox5eAU=",
      "description": "躬行客主理人",
      "location": "山东"
    },
    "text": "老师您好，我是房地产行业工程板块从业人员，从网上的渠道了解到注册人工智能师的证书考试，想试着去考一下但又不知道考了到底能给自己带来什么。内心的想法是，一现在AI这么火热想通过这次学习深入了解一下他到底是什么？增加自己的知识面，积极拥抱趋势。二是通过证书让自己有更多可能性。请问老师您如何看待？",
    "fee": {
      "amount": 800
    },
    "expired": true,
    "anonymous": false,
    "owner_detail": {
      "questions_count": 5,
